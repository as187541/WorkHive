    <mxCell id="16" value="Modals:&#xa;- CreateWorkspaceModal.jsx&#xa;- CreateProjectModal.jsx&#xa;- CreateTaskModal.jsx&#xa;- CreateJobPostingModal.jsx&#xa;- CreateServicePackageModal.jsx&#xa;- CreateAutomationModal.jsx&#xa;- SubmitProposalModal.jsx&#xa;- HireModal.jsx&#xa;- InviteModal.jsx&#xa;- AcceptProposalModal.jsx&#xa;- OrderServiceModal.jsx&#xa;- DisputeModal.jsx&#xa;- UserProfileModal.jsx&#xa;&#xa;Cards:&#xa;- WorkspaceCard.jsx&#xa;- TalentCard.jsx&#xa;- JobPostingCard.jsx&#xa;- ServicePackageCard.jsx&#xa;- AutomationRuleCard.jsx&#xa;&#xa;Specialized Components:&#xa;- KanbanBoard.jsx (task management)&#xa;- MilestoneTracker.jsx (order milestones)&#xa;- PortfolioGallery.jsx (portfolio display)&#xa;- RatingStars.jsx (5-star ratings)&#xa;- ConnectionBadge.jsx (connection status)&#xa;- HireNotificationBadge.jsx (invite count)&#xa;- MessageBadge.jsx (unread messages)&#xa;- NotificationDropdown.jsx (alerts)&#xa;- SavedSearches.jsx (saved filters)&#xa;- TalentFilters.jsx (search filters)&#xa;- TaskDetailDrawer.jsx (task details)&#xa;- OrderDetailModal.jsx (order view)&#xa;- ThemeSwitcher.jsx (dark/light mode)&#xa;- MobileNav.jsx (mobile menu)&#xa;- MobileOnboarding.jsx (onboarding)&#xa;- AdminRoute.jsx (role guard)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10" parent="1" vertex="1">
      <mxGeometry x="70" y="810" width="710" height="320" as="geometry"/>
    </mxCell>
    
    <!-- Admin Pages -->
    <mxCell id="17" value="👑 Admin Pages" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CC0000;fillColor=#FFE6E6;gradientColor=#CC0000;fontSize=16;fontStyle=1" parent="1" vertex="1">
      <mxGeometry x="850" y="760" width="700" height="380" as="geometry"/>
    </mxCell>
    
    <mxCell id="18" value="AdminRoute.jsx (Guard):&#xa;- Checks user.role === 'SuperAdmin'&#xa;- Redirects non-admin users&#xa;- Protects all /admin/* routes&#xa;&#xa;AdminDashboard.jsx:&#xa;- System overview&#xa;- User/workspace stats&#xa;- Recent activity&#xa;- Quick actions&#xa;&#xa;AdminUsersPage.jsx:&#xa;- List all users&#xa;- Search &amp; filter&#xa;- Delete users&#xa;- Update roles&#xa;&#xa;AdminWorkspacesPage.jsx:&#xa;- List all workspaces&#xa;- Create workspace&#xa;- Delete workspace&#xa;- View members&#xa;&#xa;AdminLogsPage.jsx:&#xa;- Audit log viewer&#xa;- Filter by action/user&#xa;- IP tracking&#xa;- Timestamp details&#xa;&#xa;AdminTokensPage.jsx:&#xa;- Alter user tokens&#xa;- Add/remove balance&#xa;- Transaction history&#xa;&#xa;AdminRedemptionsPage.jsx:&#xa;- Pending redemptions&#xa;- Approve/Deny actions&#xa;- Process history" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11" parent="1" vertex="1">
      <mxGeometry x="870" y="810" width="660" height="320" as="geometry"/>
    </mxCell>
    
    <!-- Hooks & Utilities -->
    <mxCell id="19" value="⚙️ Hooks &amp; Utilities" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#666666;fillColor=#F5F5F5;gradientColor=#666666;fontSize=16;fontStyle=1" parent="1" vertex="1">
      <mxGeometry x="50" y="1180" width="1500" height="180" as="geometry"/>
    </mxCell>
    
    <mxCell id="20" value="Custom Hooks:&#xa;- useActivityData.js: Fetches activity data for dashboard&#xa;&#xa;Constants:&#xa;- skills.js: Predefined skills list for filters&#xa;&#xa;Services (API layer):&#xa;- Axios instances for API calls&#xa;- Interceptors for JWT token&#xa;- Error handling&#xa;- Request/response transformers&#xa;&#xa;Styling:&#xa;- App.css: Global styles&#xa;- Component-specific CSS modules&#xa;- CSS variables for theming&#xa;- Responsive design (mobile-first)&#xa;&#xa;Build Tools:&#xa;- Vite: Fast build tool &amp; dev server&#xa;- React Refresh: Hot module replacement&#xa;- ESLint: Code linting&#xa;&#xa;Dependencies:&#xa;- react-router-dom: Routing&#xa;- axios: HTTP client&#xa;- socket.io-client: WebSocket client&#xa;- jwt-decode: JWT parsing&#xa;- react-hot-toast: Toast notifications&#xa;- recharts: Charts &amp; graphs&#xa;- react-icons: Icon library" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11" parent="1" vertex="1">
      <mxGeometry x="70" y="1230" width="1460" height="120" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
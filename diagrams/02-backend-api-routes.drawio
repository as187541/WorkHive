<mxfile host="65bd71144e">
    <diagram id="YyxLdhyi5qrXiAOinhQn" name="Page-1">
        <mxGraphModel dx="642" dy="249" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="WorkHive Backend API Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="700" y="20" width="400" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="🔐 Authentication Module" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#FF6600;fillColor=#FFF2E6;gradientColor=#FF6600;fontSize=16;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="50" y="80" width="400" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="Routes: /api/v1/auth&#xa;&#xa;POST /register&#xa;  └─ authController.register&#xa;  └─ Creates User, sends OTP email&#xa;&#xa;POST /login&#xa;  └─ authController.login&#xa;  └─ JWT token generation&#xa;&#xa;POST /otp/verify&#xa;  └─ authController.verifyOTP&#xa;  └─ Validates OTP, activates account&#xa;&#xa;GET /me&#xa;  └─ authController.getMe&#xa;  └─ Returns user profile&#xa;&#xa;PATCH /update&#xa;  └─ authController.updateProfile&#xa;  └─ Updates user data" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="70" y="80" width="360" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="🏢 Workspace Module" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0066CC;fillColor=#E6F2FF;gradientColor=#0066CC;fontSize=16;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="500" y="80" width="400" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="6" value="Routes: /api/v1/workspaces&#xa;&#xa;POST /&#xa;  └─ workspaceController.create&#xa;  └─ Creates workspace, adds owner as Admin&#xa;&#xa;GET /&#xa;  └─ workspaceController.getAll&#xa;  └─ Returns user&#39;s workspaces&#xa;&#xa;GET /:id&#xa;  └─ workspaceController.getById&#xa;  └─ Returns workspace with members&#xa;&#xa;PUT /:id&#xa;  └─ workspaceController.update&#xa;  └─ Updates workspace details&#xa;&#xa;DELETE /:id&#xa;  └─ workspaceController.delete&#xa;  └─ Removes workspace&#xa;&#xa;POST /:id/members&#xa;  └─ workspaceController.addMember&#xa;  └─ Adds member with role" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="520" y="30" width="370" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="📁 Project Module" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#009900;fillColor=#E6FFE6;gradientColor=#009900;fontSize=16;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="950" y="80" width="400" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="8" value="Routes: /workspaces/:workspaceId/projects&#xa;&#xa;POST /&#xa;  └─ projectController.create&#xa;  └─ Creates project in workspace&#xa;&#xa;GET /&#xa;  └─ projectController.getAll&#xa;  └─ Returns workspace projects&#xa;&#xa;GET /:id&#xa;  └─ projectController.getById&#xa;  └─ Returns project with tasks&#xa;&#xa;PUT /:id&#xa;  └─ projectController.update&#xa;  └─ Updates project&#xa;&#xa;DELETE /:id&#xa;  └─ projectController.delete&#xa;  └─ Removes project&#xa;&#xa;POST /:id/contractors&#xa;  └─ projectController.addContractor&#xa;  └─ Adds contractor to project" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="1010" y="40" width="360" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="✅ Task Module" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CC9900;fillColor=#FFFBE6;gradientColor=#CC9900;fontSize=16;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="1400" y="80" width="350" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="Routes: /workspaces/:wsId/projects/:projId/tasks&#xa;&#xa;POST /&#xa;  └─ taskController.create&#xa;  └─ Creates task, triggers automation&#xa;&#xa;GET /&#xa;  └─ taskController.getAll&#xa;  └─ Returns project tasks&#xa;&#xa;GET /:id&#xa;  └─ taskController.getById&#xa;  └─ Returns task details&#xa;&#xa;PUT /:id&#xa;  └─ taskController.update&#xa;  └─ Updates task status/assignment&#xa;&#xa;DELETE /:id&#xa;  └─ taskController.delete&#xa;  └─ Removes task&#xa;&#xa;POST /:id/comments&#xa;  └─ commentController.addComment" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10" parent="1" vertex="1">
                    <mxGeometry x="1430" y="60" width="310" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="💬 Messaging Module" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#9933CC;fillColor=#F2E6FF;gradientColor=#9933CC;fontSize=16;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="50" y="400" width="400" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="Routes: /api/v1/messages&#xa;&#xa;GET /conversations&#xa;  └─ messageController.getConversations&#xa;  └─ Returns user&#39;s conversations&#xa;&#xa;POST /conversations&#xa;  └─ messageController.createConversation&#xa;  └─ Creates 1-on-1 chat&#xa;&#xa;GET /conversations/:id/messages&#xa;  └─ messageController.getMessages&#xa;  └─ Returns message history&#xa;&#xa;POST /conversations/:id/messages&#xa;  └─ messageController.sendMessage&#xa;  └─ Sends message, emits Socket.IO event&#xa;&#xa;PATCH /messages/:id/read&#xa;  └─ messageController.markRead&#xa;  └─ Marks message as read" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="60" y="410" width="360" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="📋 Job Marketplace Module" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0099CC;fillColor=#E6F7FF;gradientColor=#0099CC;fontSize=16;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="500" y="400" width="400" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="14" value="Routes: /api/v1/jobs&#xa;&#xa;POST /&#xa;  └─ jobPostingController.create&#xa;  └─ Creates job posting&#xa;&#xa;GET /&#xa;  └─ jobPostingController.getAll&#xa;  └─ Returns public jobs&#xa;&#xa;GET /my-jobs&#xa;  └─ jobPostingController.getMyJobs&#xa;  └─ Returns user&#39;s posted jobs&#xa;&#xa;POST /:id/proposals&#xa;  └─ proposalController.submit&#xa;  └─ Submits proposal with milestones&#xa;&#xa;GET /:id/proposals&#xa;  └─ proposalController.getAll&#xa;  └─ Returns job proposals&#xa;&#xa;PATCH /proposals/:id/accept&#xa;  └─ proposalController.accept&#xa;  └─ Accepts proposal, creates order" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="500" y="390" width="240" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="15" value="👥 Hire &amp; Talent Module" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#FF3366;fillColor=#FFE6EC;gradientColor=#FF3366;fontSize=16;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="950" y="400" width="400" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="16" value="Routes: /api/v1/hires &amp; /api/v1/talent&#xa;&#xa;POST /hires/invite&#xa;  └─ hireController.sendInvite&#xa;  └─ Sends project invite&#xa;&#xa;GET /hires/sent&#xa;  └─ hireController.getSentInvites&#xa;  └─ Returns sent invitations&#xa;&#xa;GET /hires/received&#xa;  └─ hireController.getReceivedInvites&#xa;  └─ Returns received invites&#xa;&#xa;PATCH /hires/:id/accept&#xa;  └─ hireController.acceptInvite&#xa;  └─ Accepts, adds to project&#xa;&#xa;GET /talent&#xa;  └─ talentController.search&#xa;  └─ Search freelancers by skills&#xa;&#xa;GET /talent/:id&#xa;  └─ talentController.getProfile&#xa;  └─ Returns talent profile" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="960" y="380" width="360" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="17" value="💰 Order &amp; Escrow Module" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#00CC66;fillColor=#E6FFEC;gradientColor=#00CC66;fontSize=16;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="1400" y="400" width="350" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="18" value="Routes: /api/v1/orders&#xa;&#xa;POST /&#xa;  └─ orderController.create&#xa;  └─ Creates order from proposal&#xa;&#xa;GET /&#xa;  └─ orderController.getAll&#xa;  └─ Returns user&#39;s orders&#xa;&#xa;POST /:id/fund&#xa;  └─ orderController.fundEscrow&#xa;  └─ Funds escrow with wallet&#xa;&#xa;PATCH /:id/milestones/:mid/submit&#xa;  └─ orderController.submitMilestone&#xa;  └─ Submits work for review&#xa;&#xa;PATCH /:id/milestones/:mid/approve&#xa;  └─ orderController.approveMilestone&#xa;  └─ Releases payment&#xa;&#xa;POST /:id/dispute&#xa;  └─ orderController.createDispute" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10" parent="1" vertex="1">
                    <mxGeometry x="1430" y="400" width="310" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="19" value="📊 Additional Modules" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#666666;fillColor=#F5F5F5;gradientColor=#666666;fontSize=16;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="50" y="720" width="400" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="20" value="Ratings (/ratings)&#xa;  - POST /: Create review&#xa;  - GET /: Get user ratings&#xa;&#xa;Connections (/connections)&#xa;  - POST /request: Send connect&#xa;  - PATCH /:id/accept: Accept&#xa;  - GET /: Get network&#xa;&#xa;Activities (/activities)&#xa;  - GET /: Get activity feed&#xa;  - Logs all user actions&#xa;&#xa;Analytics (/analytics)&#xa;  - GET /dashboard: Stats&#xa;  - Returns charts data&#xa;&#xa;Automations (/automations)&#xa;  - POST /: Create rule&#xa;  - GET /: Get rules&#xa;  - Triggers on events" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="60" y="730" width="360" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="22" value="🛡️ Middleware Flow" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#FF9900;fillColor=#FFF2E6;gradientColor=#FF9900;fontSize=16;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="950" y="720" width="800" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="23" value="Request Flow:&#xa;&#xa;1. CORS Middleware&#xa;   └─ Validates origin (localhost, Netlify)&#xa;   └─ Sets CORS headers&#xa;&#xa;2. JSON Parser (express.json())&#xa;   └─ Parses request body&#xa;&#xa;3. Auth Middleware (protect)&#xa;   └─ Extracts JWT from Bearer token&#xa;   └─ Verifies token signature&#xa;   └─ Finds user, attaches to req.user&#xa;   └─ Blocks if invalid/missing&#xa;&#xa;4. Role Middleware (authorizeRoles)&#xa;   └─ Checks req.user.role&#xa;   └─ Allows if role matches&#xa;   └─ Returns 403 if forbidden&#xa;&#xa;5. Contractor Middleware (restrictContractorAccess)&#xa;   └─ Checks workspace membership&#xa;   └─ Blocks Admin routes&#xa;   └─ Allows limited paths&#xa;&#xa;6. Audit Middleware (logAuditAction)&#xa;   └─ Logs admin actions&#xa;   └─ Records IP, user agent&#xa;&#xa;7. Controller Handler&#xa;   └─ Business logic execution" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="1080" y="720" width="760" height="250" as="geometry"/>
                </mxCell>

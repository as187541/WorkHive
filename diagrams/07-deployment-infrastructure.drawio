    <!-- Deployment & Infrastructure - Page 7 -->
    
    <!-- Title -->
    <mxCell id="2" value="WorkHive Deployment &amp; Infrastructure Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" parent="1" vertex="1">
      <mxGeometry x="500" y="20" width="600" height="40" as="geometry"/>
    </mxCell>
    
    <!-- Production Architecture -->
    <mxCell id="3" value="🌐 Production Architecture" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0066CC;fillColor=#E6F2FF;gradientColor=#0066CC;fontSize=16;fontStyle=1" parent="1" vertex="1">
      <mxGeometry x="50" y="80" width="700" height="400" as="geometry"/>
    </mxCell>
    
    <mxCell id="4" value="┌─────────────────────────────────────────────────┐&#xa;│              Cloudflare / CDN                   │&#xa;│         (SSL, DDoS Protection, Caching)         │&#xa;└────────────────┬────────────────────────────────┘&#xa;                 │&#xa;                 ▼&#xa;┌─────────────────────────────────────────────────┐&#xa;│           Netlify (Frontend Hosting)            │&#xa;│  - my-saas-frontend (React + Vite)              │&#xa;│  - Automatic HTTPS                              │&#xa;│  - Global CDN                                   │&#xa;│  - Preview deployments                          │&#xa;│  - Custom domain: workhive.app                  │&#xa;└────────────────┬────────────────────────────────┘&#xa;                 │&#xa;                 │ HTTPS&#xa;                 │&#xa;                 ▼&#xa;┌─────────────────────────────────────────────────┐&#xa;│         Railway / Render / Heroku               │&#xa;│         (Backend Hosting)                       │&#xa;│  - Node.js + Express server                     │&#xa;│  - server.js entry point                        │&#xa;│  - Port: 5000                                   │&#xa;│  - Environment variables                        │&#xa;│  - Auto-deploy from Git                         │&#xa;└────────────────┬────────────────────────────────┘&#xa;                 │&#xa;                 │&#xa;                 ▼&#xa;┌─────────────────────────────────────────────────┐&#xa;│        MongoDB Atlas (Database)                 │&#xa;│  - Managed MongoDB cluster                      │&#xa;│  - M10+ cluster recommended                     │&#xa;│  - Automated backups                            │&#xa;│  - VPC peering                                  │&#xa;│  - Connection pooling                           │&#xa;└─────────────────────────────────────────────────┘" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontFamily=monospace" parent="1" vertex="1">
      <mxGeometry x="70" y="130" width="660" height="340" as="geometry"/>
    </mxCell>
    
    <!-- External Services -->
    <mxCell id="5" value="☁️ External Services" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#009900;fillColor=#E6FFE6;gradientColor=#009900;fontSize=16;fontStyle=1" parent="1" vertex="1">
      <mxGeometry x="800" y="80" width="750" height="400" as="geometry"/>
    </mxCell>
    
    <mxCell id="6" value="┌──────────────────┐&#xa;│   Cloudinary     │&#xa;│  - Image/Video   │&#xa;│    Storage       │&#xa;│  - Avatars       │&#xa;│  - Portfolio     │&#xa;│  - Attachments   │&#xa;└────────┬─────────┘&#xa;         │&#xa;         │ Upload&#xa;         │&#xa;┌────────┴─────────┐&#xa;│   Nodemailer     │&#xa;│  - Gmail SMTP    │&#xa;│  - OTP Emails    │&#xa;│  - Notifications │&#xa;│  - Password      │&#xa;│    Reset         │&#xa;└────────┬─────────┘&#xa;         │&#xa;         │ Send&#xa;         │&#xa;┌────────┴─────────┐&#xa;│  Google OAuth    │&#xa;│  - Authentication│&#xa;│  - Future:       │&#xa;│    SSO Login     │&#xa;└──────────────────┘&#xa;&#xa;All services communicate via HTTPS&#xa;Backend acts as orchestrator" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontFamily=monospace" parent="1" vertex="1">
      <mxGeometry x="820" y="130" width="330" height="340" as="geometry"/>
    </mxCell>
    
    <mxCell id="7" value="Environment Variables Required:&#xa;&#xa;Backend (.env):&#xa;- MONGO_URI=mongodb+srv://...&#xa;- JWT_SECRET=your_secret_key&#xa;- EMAIL_USER=your@gmail.com&#xa;- EMAIL_PASS=your_app_password&#xa;- CLOUDINARY_CLOUD_NAME=...&#xa;- CLOUDINARY_API_KEY=...&#xa;- CLOUDINARY_API_SECRET=...&#xa;- PORT=5000&#xa;- NODE_ENV=production&#xa;- ALLOWED_ORIGINS=https://workhive.app&#xa;&#xa;Frontend (.env):&#xa;- VITE_API_URL=https://api.workhive.app&#xa;- VITE_SOCKET_URL=https://api.workhive.app&#xa;&#xa;Security Best Practices:&#xa;- Never commit .env files&#xa;- Use strong JWT_SECRET (32+ chars)&#xa;- Enable MongoDB IP whitelist&#xa;- Use Gmail app passwords (not main password)&#xa;- Enable 2FA on all services&#xa;- Regular security audits" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10" parent="1" vertex="1">
      <mxGeometry x="1200" y="130" width="330" height="340" as="geometry"/>
    </mxCell>
    
    <!-- Development Setup -->
    <mxCell id="8" value="💻 Local Development Setup" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#FF6600;fillColor=#FFF2E6;gradientColor=#FF6600;fontSize=16;fontStyle=1" parent="1" vertex="1">
      <mxGeometry x="50" y="520" width="700" height="340" as="geometry"/>
    </mxCell>
    
    <mxCell id="9" value="Backend Setup:&#xa;&#xa;1. Install Node.js (v18+) &amp; MongoDB&#xa;&#xa;2. Clone repository&#xa;   cd WorkHive-1&#xa;&#xa;3. Install dependencies&#xa;   npm install&#xa;&#xa;4. Create .env file&#xa;   MONGO_URI=mongodb://localhost:27017/workhive&#xa;   JWT_SECRET=dev_secret&#xa;   EMAIL_USER=test@gmail.com&#xa;   EMAIL_PASS=test&#xa;   PORT=5000&#xa;&#xa;5. Start MongoDB&#xa;   mongod&#xa;&#xa;6. Run backend&#xa;   npm run dev&#xa;   Server: http://localhost:5000&#xa;&#xa;Frontend Setup:&#xa;&#xa;1. Navigate to frontend&#xa;   cd my-saas-frontend&#xa;&#xa;2. Install dependencies&#xa;   npm install&#xa;&#xa;3. Create .env file&#xa;   VITE_API_URL=http://localhost:5000&#xa;   VITE_SOCKET_URL=http://localhost:5000&#xa;&#xa;4. Run frontend&#xa;   npm run dev&#xa;   App: http://localhost:5173&#xa;&#xa;Both servers run concurrently&#xa;CORS enabled for localhost:5173" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10" parent="1" vertex="1">
      <mxGeometry x="70" y="570" width="660" height="280" as="geometry"/>
    </mxCell>
    
    <!-- Deployment Process -->
    <mxCell id="10" value="🚀 Deployment Process" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#9933CC;fillColor=#F2E6FF;gradientColor=#9933CC;fontSize=16;fontStyle=1" parent="1" vertex="1">
      <mxGeometry x="800" y="520" width="750" height="340" as="geometry"/>
    </mxCell>
    
    <mxCell id="11" value="Backend Deployment (Railway/Render):&#xa;&#xa;1. Connect GitHub repository&#xa;2. Configure build command:&#xa;   - Build: npm install&#xa;   - Start: npm start&#xa;3. Add environment variables&#xa;4. Deploy branch: main/master&#xa;5. Auto-deploy on push&#xa;6. Monitor logs in dashboard&#xa;&#xa;Frontend Deployment (Netlify):&#xa;&#xa;1. Connect GitHub repository&#xa;2. Configure build settings:&#xa;   - Base directory: my-saas-frontend&#xa;   - Build command: npm run build&#xa;   - Publish directory: my-saas-frontend/dist&#xa;3. Add environment variables&#xa;4. Deploy branch: main/master&#xa;5. Auto-deploy on push&#xa;6. Preview deployments for PRs&#xa;&#xa;Database Setup (MongoDB Atlas):&#xa;&#xa;1. Create cluster (M10 recommended)&#xa;2. Create database user&#xa;3. Whitelist IP addresses (0.0.0.0/0 for cloud)&#xa;4. Get connection string&#xa;5. Update MONGO_URI in backend&#xa;6. Test connection&#xa;&#xa;Post-Deployment:&#xa;- Verify HTTPS&#xa;- Test all API endpoints&#xa;- Check Socket.IO connection&#xa;- Monitor error logs&#xa;- Set up uptime monitoring" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10" parent="1" vertex="1">
      <mxGeometry x="820" y="570" width="710" height="280" as="geometry"/>
    </mxCell>
    
    <!-- CI/CD Pipeline -->
    <mxCell id="12" value="🔄 CI/CD Pipeline" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0099CC;fillColor=#E6F7FF;gradientColor=#0099CC;fontSize=16;fontStyle=1" parent="1" vertex="1">
      <mxGeometry x="50" y="900" width="700" height="260" as="geometry"/>
    </mxCell>
    
    <mxCell id="13" value="GitHub Actions Workflow (Optional):&#xa;&#xa;.github/workflows/deploy.yml&#xa;&#xa;name: Deploy&#xa;&#xa;on:&#xa;  push:&#xa;    branches: [ main ]&#xa;&#xa;jobs:&#xa;  deploy-backend:&#xa;    runs-on: ubuntu-latest&#xa;    steps:&#xa;      - uses: actions/checkout@v3&#xa;      - uses: actions/setup-node@v3&#xa;        with:&#xa;          node-version: '18'&#xa;      - run: npm install&#xa;      - run: npm test&#xa;      # Deploy to Railway/Render&#xa;&#xa;  deploy-frontend:&#xa;    runs-on: ubuntu-latest&#xa;    defaults:&#xa;      run:&#xa;        working-directory: ./my-saas-frontend&#xa;    steps:&#xa;      - uses: actions/checkout@v3&#xa;      - uses: actions/setup-node@v3&#xa;      - run: npm install&#xa;      - run: npm run build&#xa;      # Deploy to Netlify&#xa;&#xa;Automated Testing:&#xa;- Run test suite on PR&#xa;- Linting checks&#xa;- Build verification&#xa;- E2E tests (optional)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10" parent="1" vertex="1">
      <mxGeometry x="70" y="950" width="660" height="200" as="geometry"/>
    </mxCell>
    
    <!-- Monitoring & Maintenance -->
    <mxCell id="14" value="📊 Monitoring &amp; Maintenance" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CC0000;fillColor=#FFE6E6;gradientColor=#CC0000;fontSize=16;fontStyle=1" parent="1" vertex="1">
      <mxGeometry x="800" y="900" width="750" height="260" as="geometry"/>
    </mxCell>
    
    <mxCell id="15" value="Monitoring Tools:&#xa;&#xa;- UptimeRobot: Health check monitoring&#xa;  • Endpoint: GET /health&#xa;  • Checks every 5 minutes&#xa;  • Alerts on downtime&#xa;&#xa;- MongoDB Atlas Metrics:&#xa;  • Database performance&#xa;  • Connection count&#xa;  • Storage usage&#xa;  • Slow queries&#xa;&#xa;- Application Logs:&#xa;  • Console.log (development)&#xa;  • Winston/Morgan (production)&#xa;  • Error tracking&#xa;&#xa;- Socket.IO Monitoring:&#xa;  • Connection count&#xa;  • Event rates&#xa;  • Error tracking&#xa;&#xa;Maintenance Tasks:&#xa;&#xa;- Daily:&#xa;  • Check error logs&#xa;  • Monitor uptime&#xa;  • Review audit logs&#xa;&#xa;- Weekly:&#xa;  • Database backup verification&#xa;  • Dependency updates&#xa;  • Security patches&#xa;&#xa;- Monthly:&#xa;  • Performance optimization&#xa;  • Code review&#xa;  • Feature planning&#xa;&#xa;Health Check Endpoint:&#xa;GET /health&#xa;Response: {&#xa;  status: 'ok',&#xa;  timestamp: '...',&#xa;  uptime: 12345.67,&#xa;  environment: 'production'&#xa;}" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10" parent="1" vertex="1">
      <mxGeometry x="820" y="950" width="710" height="200" as="geometry"/>
    </mxCell>
    
